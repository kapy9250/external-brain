name = "external-brain-tts"
main = "worker.js"
compatibility_date = "2026-03-14"

[vars]
# Comma-separated allowlist supported, first value is fallback
ALLOWED_ORIGIN = "https://blog.kapy.ca,https://kapy9250.github.io"
OPENAI_TTS_MODEL = "gpt-4o-mini-tts"
OPENAI_TTS_VOICE = "alloy"

# KV stores metadata only (hash -> r2 key/url/status)
[[kv_namespaces]]
binding = "TTS_CACHE"
id = "YOUR_KV_NAMESPACE_ID"

# R2 stores audio binary bodies
[[r2_buckets]]
binding = "AUDIO_BUCKET"
bucket_name = "external-brain-tts-audio"
